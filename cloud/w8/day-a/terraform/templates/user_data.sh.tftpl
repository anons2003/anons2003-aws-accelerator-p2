#!/bin/bash
set -euxo pipefail

exec > >(tee /var/log/${project_name}-bootstrap.log) 2>&1

dnf update -y
dnf install -y nginx awscli

aws s3 cp "s3://${bucket_name}/index.html" /usr/share/nginx/html/index.html

cat >/usr/share/nginx/html/health.html <<'EOF'
ok
EOF

cat >/etc/profile.d/${project_name}.sh <<'EOF'
export APP_DB_HOST="${db_endpoint}"
export APP_DB_NAME="${db_name}"
export APP_DB_USER="${db_username}"
EOF

systemctl enable --now nginx
